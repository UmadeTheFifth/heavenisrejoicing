rules_version = '2';
service firebase.storage {
 match /b/{bucket}/o {
  function admin() { return request.auth != null && firestore.exists(/databases/(default)/documents/admins/$(request.auth.uid)); }
  match /gallery/{file} {
   allow read: if true;
   allow create: if admin() && request.resource.size <= 10 * 1024 * 1024 && request.resource.contentType.matches('image/(jpeg|png|webp|gif)');
   allow delete: if admin();
  }
  match /messages/{file} {
   allow read: if true;
   allow create: if admin() && ((request.resource.contentType.matches('video/.*') && request.resource.size <= 200 * 1024 * 1024) || (request.resource.contentType.matches('audio/.*') && request.resource.size <= 100 * 1024 * 1024) || (request.resource.contentType.matches('application/pdf|text/plain') && request.resource.size <= 25 * 1024 * 1024));
   allow delete: if admin();
  }
 }
}
